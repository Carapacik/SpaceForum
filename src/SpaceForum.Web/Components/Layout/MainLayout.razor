@inherits LayoutComponentBase
@using SpaceForum.Application.Security
@using SpaceForum.Application.Forums
@using System.Globalization
@inject SpaceForum.Web.Services.ForumSettingsService ForumSettings

<div class="min-h-dvh bg-canvas text-content" style="@ThemeStyle">
    <a href="#main-content"
       class="fixed left-3 top-3 z-50 -translate-y-24 rounded-control bg-primary px-4 py-2 font-semibold text-white transition-transform focus:translate-y-0">
        @T["Skip to content"]
    </a>

    <header class="sticky top-0 z-40 border-b bg-surface/95 backdrop-blur">
        <div class="mx-auto flex h-14 max-w-[100rem] items-center gap-3 px-4 medium:h-16 medium:px-6">
            <a href="/" class="flex min-h-11 items-center gap-3 rounded-control" aria-label="@($"{settings.Name} {T["Home"]}")">
                <span class="grid size-9 place-items-center rounded-[0.75rem] bg-primary text-white shadow-sm" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M12 3.25a8.75 8.75 0 1 0 8.75 8.75" />
                        <path d="M15.5 3.75h4.75v4.75M20 4l-7.25 7.25" />
                        <circle cx="12" cy="12" r="2.25" fill="currentColor" stroke="none" />
                    </svg>
                </span>
                <span class="font-display text-lg font-bold tracking-[-0.02em]">@settings.Name</span>
            </a>

            <div class="ml-auto hidden min-w-0 max-w-md flex-1 expanded:block">
                <form action="/search" method="get" class="sf-search-box" data-search-suggest>
                    <label class="sr-only" for="global-search">@T["Search discussions"]</label>
                    <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3 top-3 size-5 text-content-muted" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="11" cy="11" r="6.5" />
                        <path d="m16 16 4 4" />
                    </svg>
                    <input id="global-search" name="q" type="search" class="sf-search-input" placeholder="@T["Search discussions"]" autocomplete="off" aria-autocomplete="list" aria-controls="global-search-results" aria-expanded="false" />
                    <span class="pointer-events-none absolute right-3 top-2.5 rounded border px-1.5 py-0.5 text-xs text-content-muted">/</span>
                    <div id="global-search-results" class="sf-search-results" role="listbox" hidden></div>
                </form>
            </div>

            <nav class="ml-auto flex items-center gap-1 expanded:ml-0" aria-label="@T["Account"]">
                <a class="sf-language-switch"
                   href="@LanguageSwitchUrl"
                   data-language-switch
                   aria-label="@T["Change language"]"
                   title="@T["Change language"]">@TargetCulture.ToUpperInvariant()</a>
                <a href="/search" class="sf-icon-button expanded:hidden" aria-label="@T["Search"]">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="11" cy="11" r="6.5" />
                        <path d="m16 16 4 4" />
                    </svg>
                </a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/notifications" class="sf-icon-button" aria-label="@T["Notifications"]" title="@T["Notifications"]">
                            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6.5 9a5.5 5.5 0 0 1 11 0c0 6 2.5 6 2.5 7.5H4C4 15 6.5 15 6.5 9Z"/><path d="M10 20h4"/></svg>
                        </a>
                        <a href="/messages" class="sf-icon-button" aria-label="@T["Messages"]" title="@T["Messages"]">
                            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg>
                        </a>
                        <AuthorizeView Policy="@ForumPolicies.AdministerForum" Context="adminContext">
                            <Authorized>
                                <a href="/admin/overview" class="sf-button-secondary hidden medium:inline-flex">@T["Admin"]</a>
                            </Authorized>
                        </AuthorizeView>
                        <a href="/account/manage" class="sf-button-secondary hidden medium:inline-flex">@T["Account"]</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/account/login" class="sf-button-secondary hidden medium:inline-flex">@T["Sign in"]</a>
                        <a href="/account/register" class="sf-button-primary">@T["Join"]</a>
                    </NotAuthorized>
                </AuthorizeView>
            </nav>
        </div>
    </header>

    <div class="mx-auto grid max-w-[82rem] grid-cols-1 gap-6 px-4 pb-24 pt-5 medium:px-6 expanded:grid-cols-[4.5rem_minmax(0,1fr)] expanded:pb-8 large:grid-cols-[15rem_minmax(0,1fr)] large:gap-8 large:pt-8">
        <aside class="hidden expanded:block" aria-label="@T["Primary navigation"]">
            <nav class="sticky top-24 space-y-1">
                <NavLink href="/" Match="NavLinkMatch.All" class="sf-nav-link" aria-label="@T["Home"]">
                    <svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z" />
                    </svg>
                    <span class="hidden large:inline">@T["Home"]</span>
                </NavLink>
                <NavLink href="/categories" class="sf-nav-link" aria-label="@T["Categories"]">
                    <svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <rect x="3.5" y="4" width="7" height="7" rx="1.5" />
                        <rect x="13.5" y="4" width="7" height="7" rx="1.5" />
                        <rect x="3.5" y="14" width="7" height="6" rx="1.5" />
                        <rect x="13.5" y="14" width="7" height="6" rx="1.5" />
                    </svg>
                    <span class="hidden large:inline">@T["Categories"]</span>
                </NavLink>
                <NavLink href="/search" class="sf-nav-link" aria-label="@T["Search"]">
                    <svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="11" cy="11" r="6.5" />
                        <path d="m16 16 4 4" />
                    </svg>
                    <span class="hidden large:inline">@T["Search"]</span>
                </NavLink>
                <AuthorizeView Policy="@ForumPolicies.AdministerForum">
                    <Authorized>
                        <NavLink href="/admin/overview" class="sf-nav-link" aria-label="@T["Administration"]">
                            <svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3.5 14 5l2.5-.2.7 2.4 2.1 1.3-1 2.3 1 2.3-2.1 1.3-.7 2.4-2.5-.2-2 1.5-2-1.5-2.5.2-.7-2.4-2.1-1.3 1-2.3-1-2.3 2.1-1.3.7-2.4L10 5z" /><circle cx="12" cy="10.8" r="2.5" /></svg>
                            <span class="hidden large:inline">@T["Admin"]</span>
                        </NavLink>
                        <NavLink href="/admin/reports" class="sf-nav-link" aria-label="@T["Moderation queue"]">
                            <svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3v18M7 5h10l-2 4 2 4H7"/></svg>
                            <span class="hidden large:inline">@T["Reports"]</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView>
                    <Authorized>
                        <NavLink href="/bookmarks" class="sf-nav-link" aria-label="@T["Bookmarks"]">
                            <svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 4h10v16l-5-3-5 3z"/></svg>
                            <span class="hidden large:inline">@T["Bookmarks"]</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
            </nav>
        </aside>

        <main id="main-content" class="min-w-0" tabindex="-1">
            @Body
        </main>

    </div>

    <nav class="fixed inset-x-0 bottom-0 z-40 grid h-[4.5rem] grid-cols-4 border-t bg-surface/95 px-2 pb-[env(safe-area-inset-bottom)] backdrop-blur expanded:hidden" aria-label="@T["Mobile navigation"]">
        <NavLink href="/" Match="NavLinkMatch.All" class="flex flex-col items-center justify-center gap-1 rounded-control text-xs font-medium text-content-muted active:text-primary">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1z" /></svg>
            @T["Home"]
        </NavLink>
        <NavLink href="/categories" class="flex flex-col items-center justify-center gap-1 rounded-control text-xs font-medium text-content-muted active:text-primary">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1" /><rect x="14" y="4" width="6" height="6" rx="1" /><rect x="4" y="14" width="6" height="6" rx="1" /><rect x="14" y="14" width="6" height="6" rx="1" /></svg>
            @T["Browse"]
        </NavLink>
        <NavLink href="/search" class="flex flex-col items-center justify-center gap-1 rounded-control text-xs font-medium text-content-muted active:text-primary">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
            @T["Search"]
        </NavLink>
        <AuthorizeView>
            <Authorized>
                <a href="/account/manage" class="flex flex-col items-center justify-center gap-1 rounded-control text-xs font-medium text-content-muted">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c.6-4 3-6 7-6s6.4 2 7 6" /></svg>
                    @T["Account"]
                </a>
            </Authorized>
            <NotAuthorized>
                <a href="/account/login" class="flex flex-col items-center justify-center gap-1 rounded-control text-xs font-medium text-content-muted">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c.6-4 3-6 7-6s6.4 2 7 6" /></svg>
                    @T["Sign in"]
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

<dialog id="confirmation-dialog" class="sf-dialog" aria-labelledby="confirmation-dialog-title">
    <div class="space-y-5 p-6">
        <div>
            <p class="sf-eyebrow">@T["Confirmation"]</p>
            <h2 id="confirmation-dialog-title" data-confirm-dialog-title class="mt-2 font-display text-xl font-bold">@T["Are you sure?"]</h2>
            <p data-confirm-dialog-message class="mt-2 text-sm text-content-muted"></p>
        </div>
        <div class="flex flex-wrap justify-end gap-3 border-t pt-5">
            <form method="dialog">
                <button type="submit" class="sf-button-secondary">@T["Cancel"]</button>
            </form>
            <button type="button" class="sf-button-primary" data-confirm-dialog-accept>@T["Confirm"]</button>
        </div>
    </div>
</dialog>

<div id="blazor-error-ui" data-nosnippet>
    @T["Something went wrong."]
    <a href="." class="reload font-semibold text-primary">@T["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ForumSettingsView settings = new(
        "SpaceForum",
        "A modern community forum.",
        "Good conversations deserve room to breathe.",
        "#6d28d9",
        false);

    private string ThemeStyle =>
        $"--sf-primary:{settings.AccentColor};--sf-primary-hover:color-mix(in srgb,{settings.AccentColor} 82%,black);--sf-accent:{settings.AccentColor}";

    private string TargetCulture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "en" : "ru";

    protected override async Task OnInitializedAsync()
    {
        settings = await ForumSettings.GetAsync(CancellationToken.None);
    }

    private string LanguageSwitchUrl
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var returnUrl = string.IsNullOrEmpty(path) ? "/" : $"/{path}";
            return $"/culture/set?culture={TargetCulture}&returnUrl={Uri.EscapeDataString(returnUrl)}";
        }
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
