@page "/account/resetpassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using SpaceForum.Application.Security
@using SpaceForum.Infrastructure.Identity

@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager
@inject ISecurityAuditWriter SecurityAudit

<PageTitle>@T["Choose a new password · SpaceForum"]</PageTitle>

<div class="sf-auth-shell">
    <header class="mb-6"><p class="sf-eyebrow">@T["Account recovery"]</p><h1 class="mt-2 font-display text-3xl font-bold">@T["Choose a new password"]</h1><p class="mt-2 text-content-muted">@T["Password requirements"]</p></header>
    <StatusMessage Message="@Message" />
    <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post" class="sf-auth-card sf-required-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />
        <input type="hidden" name="Input.Code" value="@Input.Code" />
        <input type="hidden" name="Input.UserId" value="@Input.UserId" />
        <div>
            <label for="Input.Password">@T["New password"]</label>
            <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" minlength="12" required aria-required="true" placeholder="Enter a strong password" />
            <ValidationMessage For="() => Input.Password" class="text-danger" />
        </div>
        <div>
            <label for="Input.ConfirmPassword">@T["Confirm new password"]</label>
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" minlength="12" required aria-required="true" placeholder="Repeat the same password" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
        </div>
        <button type="submit" class="sf-submit w-full">@T["Save new password"]</button>
    </EditForm>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    protected override void OnInitialized()
    {
        Input ??= new();
        if (Code is null || !Guid.TryParse(UserId, out _))
        {
            RedirectManager.RedirectTo("account/invalidpasswordreset");
            return;
        }

        Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        Input.UserId = UserId;
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByIdAsync(Input.UserId);
        if (user is null)
        {
            RedirectManager.RedirectTo("account/resetpasswordconfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            await SecurityAudit.WriteAsync(new(SecurityEventTypes.PasswordResetCompleted, user.Id, user.Id.ToString(), true), CancellationToken.None);
            RedirectManager.RedirectTo("account/resetpasswordconfirmation");
            return;
        }

        identityErrors = result.Errors;
        await SecurityAudit.WriteAsync(new(SecurityEventTypes.PasswordResetCompleted, user.Id, user.Id.ToString(), false), CancellationToken.None);
    }

    private sealed class InputModel
    {
        [Required, StringLength(100, MinimumLength = 12)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";

        [Required]
        public string Code { get; set; } = "";

        [Required]
        public string UserId { get; set; } = "";
    }
}
