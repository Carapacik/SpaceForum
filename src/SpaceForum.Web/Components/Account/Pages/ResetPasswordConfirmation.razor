@page "/account/resetpasswordconfirmation"

<PageTitle>@T["Password changed"] · SpaceForum</PageTitle>

<section class="sf-auth-shell sf-card p-6 text-center medium:p-8">
    <p class="sf-eyebrow">@T["Account"]</p>
    <h1 class="mt-2 font-display text-2xl font-bold">@T["Password changed"]</h1>
    <p class="mt-3 text-content-muted" role="alert">@T["Password changed help"]</p>
    <a class="sf-button-primary mt-6" href="/account/login">@T["Sign in"]</a>
</section>
