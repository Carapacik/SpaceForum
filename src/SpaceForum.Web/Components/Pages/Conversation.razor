@page "/messages/{ConversationId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using SpaceForum.Application.Messaging
@using SpaceForum.Web.Security
@inject MessagingService Messaging
@inject SpaceForum.Web.Rendering.ForumMarkdownRenderer Markdown
<PageTitle>@(conversation?.Subject??T["Messages"]) · SpaceForum</PageTitle>@if(conversation is null){<div class="sf-card p-8">@T["Conversation not found."]</div>}else{<div class="space-y-5"><header><a class="text-sm font-bold text-primary" href="/messages">← @T["Messages"]</a><h1 class="mt-2 font-display text-3xl font-bold">@conversation.Subject</h1></header><section class="space-y-3">@foreach(var message in conversation.Messages){<article class="sf-card p-5"><div class="flex justify-between gap-3"><a class="font-bold" href="@($"/members/{message.AuthorLogin}")">@message.AuthorDisplayName</a><time class="text-sm text-content-muted" datetime="@message.CreatedAt.ToString("O")" data-local-time="date-time">@message.CreatedAt</time></div><div class="sf-markdown mt-3">@((MarkupString)Markdown.ToHtml(message.Body))</div></article>}</section><form method="post" action="@($"/actions/messages/{ConversationId}/send")" class="sf-card space-y-4 p-5"><AntiforgeryToken/><label for="reply-message">@T["Reply"]</label><textarea id="reply-message" name="body" class="form-control min-h-36" minlength="2" maxlength="10000" required></textarea><button class="sf-button-primary" type="submit">@T["Send message"]</button></form></div>}
@code {[Parameter]public Guid ConversationId{get;set;}private ConversationDetailView?conversation;[CascadingParameter]private HttpContext HttpContext{get;set;}=default!;protected override async Task OnParametersSetAsync(){if(HttpContext.User.GetMemberId() is Guid member)conversation=await Messaging.GetAsync(ConversationId,member,HttpContext.RequestAborted);}}
