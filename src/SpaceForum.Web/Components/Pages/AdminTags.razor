@page "/admin/tags"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = SpaceForum.Application.Security.ForumPolicies.AdministerForum)]
@using System.ComponentModel.DataAnnotations
@using SpaceForum.Application.Forums
@inject IForumFeatureRepository Features
<PageTitle>@T["Tags"] · SpaceForum</PageTitle>
<div class="space-y-5"><header><p class="sf-eyebrow">@T["Administration"]</p><h1 class="mt-1 font-display text-3xl font-bold">@T["Tags"]</h1></header>
<div class="grid gap-6 large:grid-cols-[minmax(0,1fr)_22rem]"><section class="sf-card divide-y overflow-hidden">@foreach(var tag in tags){<div class="flex items-center justify-between gap-4 p-4"><div><span class="sf-tag" style="@($"--tag-color:{tag.Color}")">@tag.Name</span><p class="mt-2 text-sm text-content-muted">/@tag.Slug · @tag.Description</p></div><form method="post" action="@($"/actions/tags/{tag.Id}/delete")" data-confirm-submit="@T["The tag will be removed from all topics."]" data-confirm-title="@T["Delete tag?"]" data-confirm-label="@T["Delete"]" data-confirm-tone="danger"><AntiforgeryToken/><button class="sf-inline-danger" type="submit">@T["Delete"]</button></form></div>}</section>
<EditForm Model="Input" method="post" FormName="create-tag" OnValidSubmit="CreateAsync" class="sf-card h-fit space-y-4 p-5"><DataAnnotationsValidator/><h2 class="font-display text-xl font-bold">@T["New tag"]</h2><ValidationSummary class="text-danger"/><div><label for="tag-name">@T["Name"]</label><InputText id="tag-name" @bind-Value="Input.Name" class="form-control"/></div><div><label for="tag-slug">@T["Slug"]</label><InputText id="tag-slug" @bind-Value="Input.Slug" class="form-control"/></div><div><label for="tag-description">@T["Description"]</label><InputText id="tag-description" @bind-Value="Input.Description" class="form-control"/></div><div><label for="tag-color">@T["Color"]</label><InputText id="tag-color" @bind-Value="Input.Color" class="form-control" type="color"/></div><div><label for="tag-position">@T["Position"]</label><InputNumber id="tag-position" @bind-Value="Input.Position" class="form-control"/></div><button class="sf-button-primary w-full" type="submit">@T["Create tag"]</button></EditForm></div></div>
@code { private IReadOnlyList<TagView> tags=[]; [SupplyParameterFromForm] private InputModel Input{get;set;}=default!; [CascadingParameter]private HttpContext HttpContext{get;set;}=default!; protected override async Task OnInitializedAsync(){Input??=new();tags=await Features.GetTagsAsync(HttpContext.RequestAborted);} private async Task CreateAsync(){if(await Features.CreateTagAsync(new(Guid.CreateVersion7(),Input.Name,Input.Slug,Input.Description,Input.Color,Input.Position),HttpContext.RequestAborted)){Input=new();tags=await Features.GetTagsAsync(HttpContext.RequestAborted);}} private sealed class InputModel{[Required,StringLength(40,MinimumLength=2)]public string Name{get;set;}=string.Empty;[Required,RegularExpression("^[a-z0-9-]{2,40}$")]public string Slug{get;set;}=string.Empty;[Required,StringLength(160,MinimumLength=2)]public string Description{get;set;}=string.Empty;[Required,RegularExpression("^#[0-9a-fA-F]{6}$")]public string Color{get;set;}="#6d28d9";[Range(0,10000)]public int Position{get;set;}}
}
