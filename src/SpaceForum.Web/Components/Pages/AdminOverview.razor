@page "/admin/overview"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = SpaceForum.Application.Security.ForumPolicies.AdministerForum)]
@using SpaceForum.Application.Forums
@inject IForumAdministrationRepository Administration
<PageTitle>@T["Dashboard"] · SpaceForum</PageTitle>
<div class="space-y-6"><header><p class="sf-eyebrow">@T["Administration"]</p><h1 class="mt-1 font-display text-3xl font-bold">@T["Dashboard"]</h1></header><div class="grid gap-4 medium:grid-cols-2 large:grid-cols-3">@foreach(var item in Cards){<div class="sf-card p-5"><p class="text-sm font-bold text-content-muted">@T[item.Label]</p><p class="mt-2 font-display text-3xl font-extrabold">@item.Value</p></div>}</div><div class="flex flex-wrap gap-3"><a class="sf-button-secondary" href="/admin/users">@T["Users"]</a><a class="sf-button-secondary" href="/admin/permissions">@T["Groups and permissions"]</a><a class="sf-button-secondary" href="/admin/reports">@T["Moderation queue"]</a><a class="sf-button-secondary" href="/admin/tags">@T["Tags"]</a><a class="sf-button-secondary" href="/admin/settings">@T["Settings"]</a><a class="sf-button-secondary" href="/admin/audit">@T["Audit log"]</a></div></div>
@code { private ForumStatistics stats=new(0,0,0,0,0,0); private IEnumerable<(string Label,int Value)> Cards=>[("Members",stats.Members),("Topic count",stats.Topics),("Posts",stats.Posts),("Open reports",stats.OpenReports),("Notifications",stats.Notifications),("Private messages",stats.Messages)]; [CascadingParameter]private HttpContext HttpContext{get;set;}=default!; protected override async Task OnInitializedAsync()=>stats=await Administration.GetStatisticsAsync(HttpContext.RequestAborted); }
