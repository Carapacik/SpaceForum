@page "/topics/new"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using SpaceForum.Application.Discussions
@using SpaceForum.Application.Forums
@using SpaceForum.Domain.Discussions
@using SpaceForum.Web.Security

@inject GetCategoriesHandler GetCategories
@inject CreateTopicHandler CreateTopicHandler
@inject NavigationManager NavigationManager

<PageTitle>@T["New topic · SpaceForum"]</PageTitle>

<div class="mx-auto max-w-2xl">
    <header class="mb-5"><p class="sf-eyebrow">@T["Create"]</p><h1 class="mt-1 font-display text-3xl font-bold">@T["New topic"]</h1></header>

    @if (error is not null)
    {
        <div class="alert alert-danger mb-4" role="alert">@error</div>
    }

    <EditForm Model="Input" method="post" FormName="create-topic" OnValidSubmit="CreateAsync" class="sf-card sf-required-form space-y-5 p-5 medium:p-6">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />
        <div>
            <label for="Input.CategoryId">@T["Category"]</label>
            <InputSelect @bind-Value="Input.CategoryId" id="Input.CategoryId" class="form-select" required>
                <option value="">@T["Choose a category"]</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="() => Input.CategoryId" class="text-danger" />
        </div>
        <div>
            <label for="Input.Title">@T["Title"]</label>
            <InputText @bind-Value="Input.Title" id="Input.Title" class="form-control" minlength="5" required maxlength="@Topic.TitleMaxLength" />
            <ValidationMessage For="() => Input.Title" class="text-danger" />
        </div>
        <div>
            <label for="Input.Body">@T["Message"]</label>
            <InputTextArea @bind-Value="Input.Body" id="Input.Body" class="form-control min-h-56" minlength="5" required maxlength="@Post.BodyMaxLength" />
            <p class="form-text mt-1">Markdown is supported, including fenced code blocks.</p>
            <ValidationMessage For="() => Input.Body" class="text-danger" />
        </div>
        <div class="flex gap-3 border-t pt-5"><button class="sf-submit" type="submit">@T["Publish topic"]</button><a class="sf-button-secondary" href="/categories">@T["Cancel"]</a></div>
    </EditForm>
</div>

@code {
    private IReadOnlyList<CategoryView> categories = [];
    private string? error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Category { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        categories = await GetCategories.ListAsync(HttpContext.RequestAborted);
        if (HttpMethods.IsGet(HttpContext.Request.Method) && Category is not null)
        {
            Input.CategoryId = categories.SingleOrDefault(item => item.Slug == Category)?.Id;
        }
    }

    private async Task CreateAsync()
    {
        var memberId = HttpContext.User.GetMemberId();
        if (memberId is null || Input.CategoryId is null)
        {
            error = "Your account or category could not be resolved.";
            return;
        }

        var result = await CreateTopicHandler.HandleAsync(
            new(memberId.Value, Input.CategoryId.Value, Input.Title, Input.Body),
            HttpContext.RequestAborted);
        if (result.Status is CreateTopicStatus.Created && result.Route is TopicRoute route)
        {
            NavigationManager.NavigateTo(route.Path);
            return;
        }

        error = result.Error ?? "The topic could not be created.";
    }

    private sealed class InputModel
    {
        [Required]
        public Guid? CategoryId { get; set; }

        [Required, StringLength(Topic.TitleMaxLength, MinimumLength = 5)]
        public string Title { get; set; } = string.Empty;

        [Required, StringLength(Post.BodyMaxLength, MinimumLength = 5)]
        public string Body { get; set; } = string.Empty;
    }
}
