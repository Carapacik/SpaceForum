@page "/messages/new"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
<PageTitle>@T["New message"] · SpaceForum</PageTitle><form method="post" action="/actions/messages/create" class="sf-card mx-auto max-w-2xl space-y-5 p-6"><AntiforgeryToken/><h1 class="font-display text-3xl font-bold">@T["New message"]</h1><div><label for="message-recipient">@T["Recipient login"]</label><input id="message-recipient" name="recipient" class="form-control" pattern="[a-z0-9]{3,30}" required/></div><div><label for="message-subject">@T["Subject"]</label><input id="message-subject" name="subject" class="form-control" minlength="3" maxlength="160" required/></div><div><label for="message-body">@T["Message"]</label><textarea id="message-body" name="body" class="form-control min-h-48" minlength="2" maxlength="10000" required></textarea></div><button class="sf-button-primary" type="submit">@T["Send message"]</button></form>
