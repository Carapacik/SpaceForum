@page "/"

@using SpaceForum.Application.Discussions

@inject GetDiscussionsHandler GetDiscussions

<PageTitle>@T["SpaceForum · thoughtful conversations"]</PageTitle>

<HeadContent>
    <meta name="description" content="@T["SpaceForum is a modern community for programming, computer games, thoughtful discussions, and useful answers."]" />
</HeadContent>

<div class="space-y-7">
    <section class="sf-card overflow-hidden">
        <div class="relative px-5 py-8 medium:px-8 medium:py-12">
            <div class="pointer-events-none absolute -right-16 -top-20 size-64 rounded-full bg-primary/15 blur-3xl" aria-hidden="true"></div>
            <div class="pointer-events-none absolute -bottom-24 left-1/3 size-56 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
            <div class="relative max-w-2xl">
                <p class="sf-eyebrow">@T["Welcome to SpaceForum"]</p>
                <h1 class="mt-3 font-display text-3xl font-extrabold tracking-[-0.035em] medium:text-5xl medium:leading-[1.08]">@T["Good conversations deserve room to breathe."]</h1>
                <p class="mt-4 max-w-xl text-base text-content-muted medium:text-lg">@T["Home description"]</p>
                <div class="mt-7 flex flex-col gap-3 medium:flex-row">
                    <AuthorizeView>
                        <Authorized><a href="/topics/new" class="sf-button-primary">@T["Start a topic"]</a></Authorized>
                        <NotAuthorized><a href="/account/register" class="sf-button-primary">@T["Create an account"]</a></NotAuthorized>
                    </AuthorizeView>
                    <a href="/categories" class="sf-button-secondary">@T["Explore categories"]</a>
                </div>
            </div>
        </div>
    </section>

    <section aria-labelledby="topics-heading">
        <div class="mb-4 flex flex-col gap-3 medium:flex-row medium:items-end medium:justify-between">
            <div><p class="sf-eyebrow">@T["Discussions"]</p><h2 id="topics-heading" class="mt-1 font-display text-2xl font-bold">@SortTitle</h2></div>
            <nav class="flex flex-wrap gap-1" aria-label="@T["Sort discussions"]">
                @foreach (var option in SortOptions)
                {
                    <a class="sf-sort-link @(sort == option.Value ? "active" : null)" href="@($"/?sort={option.Query}")">@T[option.Label]</a>
                }
            </nav>
        </div>

        @if (topics.Count == 0)
        {
            <div class="sf-card px-5 py-10 text-center"><p class="text-content-muted">@T["No discussions yet. Start the first one."]</p></div>
        }
        else
        {
            <div class="sf-card divide-y overflow-hidden">
                @foreach (var topic in topics)
                {
                    <a class="grid gap-2 px-5 py-4 transition-colors hover:bg-surface-muted medium:grid-cols-[minmax(0,1fr)_auto] medium:items-center medium:px-6" href="@($"/d/{topic.Number}-{topic.Slug}")">
                        <span class="min-w-0">
                            <span class="block truncate font-bold">@topic.Title</span>
                            <span class="mt-1 block text-sm text-content-muted">@topic.CategoryName · @topic.AuthorDisplayName</span>
                        </span>
                        <span class="flex items-center gap-3 text-sm text-content-muted">
                            <span title="@T["Topic score"]">@FormatScore(topic.Score)</span>
                            <span>@topic.ReplyCount @T["replies"]</span>
                            <time datetime="@topic.LastActivityAt.ToString("O")" data-local-time="relative">@topic.LastActivityAt.ToString("MMM d, yyyy")</time>
                        </span>
                    </a>
                }
            </div>
        }
    </section>
</div>

@code {
    private static readonly (TopicSort Value, string Query, string Label)[] SortOptions =
    [
        (TopicSort.Latest, "latest", "Latest"),
        (TopicSort.Newest, "newest", "Newest"),
        (TopicSort.Oldest, "oldest", "Oldest"),
        (TopicSort.Top, "top", "Top"),
        (TopicSort.HighestRated, "highest-rated", "Highest rated"),
        (TopicSort.LowestRated, "lowest-rated", "Lowest rated"),
    ];

    private IReadOnlyList<TopicListItem> topics = [];
    private TopicSort sort;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "sort")]
    private string? SortQuery { get; set; }

    private string SortTitle => $"{T[SortOptions.Single(option => option.Value == sort).Label]} {T["topics"]}";

    protected override async Task OnParametersSetAsync()
    {
        sort = SortOptions.FirstOrDefault(
            option => string.Equals(option.Query, SortQuery, StringComparison.OrdinalIgnoreCase),
            SortOptions[0]).Value;
        topics = await GetDiscussions.ListAsync(sort, 20, HttpContext.RequestAborted);
    }

    private static string FormatScore(int score) => score > 0 ? $"+{score}" : score.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
