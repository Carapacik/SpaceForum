@page "/admin/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = SpaceForum.Application.Security.ForumPolicies.AdministerForum)]
@using System.ComponentModel.DataAnnotations
@using SpaceForum.Application.Forums
@using SpaceForum.Web.Security
@inject SpaceForum.Web.Services.ForumSettingsService ForumSettings
@inject TimeProvider TimeProvider
<PageTitle>@T["Settings"] · SpaceForum</PageTitle><div class="mx-auto max-w-3xl space-y-5"><header><p class="sf-eyebrow">@T["Administration"]</p><h1 class="mt-1 font-display text-3xl font-bold">@T["Settings"]</h1></header>@if(saved){<div class="alert" role="status">@T["Settings saved."]</div>}<EditForm Model="Input" method="post" FormName="forum-settings" OnValidSubmit="SaveAsync" class="sf-card space-y-5 p-6"><DataAnnotationsValidator/><ValidationSummary class="text-danger"/><div><label for="settings-name">@T["Forum name"]</label><InputText id="settings-name" @bind-Value="Input.Name" class="form-control"/></div><div><label for="settings-description">@T["Description"]</label><InputTextArea id="settings-description" @bind-Value="Input.Description" class="form-control"/></div><div><label for="settings-welcome">@T["Welcome banner"]</label><InputText id="settings-welcome" @bind-Value="Input.Welcome" class="form-control"/></div><div><label for="settings-accent">@T["Accent color"]</label><InputText id="settings-accent" @bind-Value="Input.AccentColor" type="color" class="form-control h-12"/></div><label class="flex gap-3"><InputCheckbox @bind-Value="Input.MaintenanceMode"/><span>@T["Maintenance mode"]</span></label><button class="sf-button-primary" type="submit">@T["Save settings"]</button></EditForm></div>
@code { [SupplyParameterFromForm]private InputModel Input{get;set;}=default!;[CascadingParameter]private HttpContext HttpContext{get;set;}=default!;private bool saved;protected override async Task OnInitializedAsync(){Input??=new();if(string.IsNullOrEmpty(Input.Name)){var value=await ForumSettings.GetAsync(HttpContext.RequestAborted);Input=new(){Name=value.Name,Description=value.Description,Welcome=value.Welcome,AccentColor=value.AccentColor,MaintenanceMode=value.MaintenanceMode};}}private async Task SaveAsync(){if(HttpContext.User.GetMemberId() is Guid actor){await ForumSettings.SaveAsync(new(Input.Name,Input.Description,Input.Welcome,Input.AccentColor,Input.MaintenanceMode),actor,TimeProvider.GetUtcNow(),HttpContext.RequestAborted);saved=true;}}private sealed class InputModel{[Required,StringLength(80,MinimumLength=2)]public string Name{get;set;}=string.Empty;[Required,StringLength(300,MinimumLength=2)]public string Description{get;set;}=string.Empty;[Required,StringLength(160,MinimumLength=2)]public string Welcome{get;set;}=string.Empty;[Required,RegularExpression("^#[0-9a-fA-F]{6}$")]public string AccentColor{get;set;}="#6d28d9";public bool MaintenanceMode{get;set;}}
}
