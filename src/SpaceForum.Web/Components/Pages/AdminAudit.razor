@page "/admin/audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = SpaceForum.Application.Security.ForumPolicies.AdministerForum)]
@using SpaceForum.Application.Forums
@inject IForumAdministrationRepository Administration
<PageTitle>@T["Audit log"] · SpaceForum</PageTitle><div class="space-y-5"><header><p class="sf-eyebrow">@T["Administration"]</p><h1 class="mt-1 font-display text-3xl font-bold">@T["Audit log"]</h1></header><div class="sf-card overflow-x-auto"><table class="w-full text-left text-sm"><thead class="bg-surface-muted"><tr><th class="p-3">@T["Time"]</th><th class="p-3">@T["Event"]</th><th class="p-3">@T["Actor"]</th><th class="p-3">@T["Subject"]</th><th class="p-3">@T["Result"]</th></tr></thead><tbody class="divide-y">@foreach(var item in events){<tr><td class="p-3"><time datetime="@item.OccurredAt.ToString("O")" data-local-time="date-time">@item.OccurredAt</time></td><td class="p-3 font-mono">@item.EventType</td><td class="p-3">@(item.ActorLogin??"—")</td><td class="p-3">@(item.SubjectId??"—")</td><td class="p-3">@(item.Succeeded?T["Success"]:T["Failed"])</td></tr>}</tbody></table></div></div>
@code { private IReadOnlyList<AuditEventView> events=[];[CascadingParameter]private HttpContext HttpContext{get;set;}=default!;protected override async Task OnInitializedAsync()=>events=await Administration.GetAuditAsync(200,HttpContext.RequestAborted);}
