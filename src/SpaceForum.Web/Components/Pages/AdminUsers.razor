@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = SpaceForum.Application.Security.ForumPolicies.AdministerForum)]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SpaceForum.Application.Members
@using SpaceForum.Application.Security
@using SpaceForum.Infrastructure.Identity
@inject UserManager<ApplicationUser> Users
@inject GetMemberProfileHandler Profiles
<PageTitle>@T["Users"] · SpaceForum</PageTitle>
<div class="space-y-5"><header><p class="sf-eyebrow">@T["Administration"]</p><h1 class="mt-1 font-display text-3xl font-bold">@T["Users"]</h1></header><section class="space-y-3">@foreach(var item in items){<article class="sf-card flex flex-wrap items-center justify-between gap-4 p-5"><div><a class="font-bold text-primary" href="@($"/members/{item.Login}")">@item.DisplayName</a><p class="text-sm text-content-muted">@@@item.Login · @item.Email · @string.Join(", ",item.Roles)</p>@if(item.Suspended){<span class="text-sm font-bold text-danger">@T["Suspended"]</span>}</div>@if(item.Login!="admin"){<div class="flex flex-wrap gap-2"><form method="post" action="@($"/actions/users/{item.Id}/role")"><AntiforgeryToken/><select class="form-select" name="role">@foreach(var role in RoleChoices){<option value="@role" selected="@item.Roles.Contains(role)">@role</option>}</select><button class="sf-button-secondary mt-2" type="submit">@T["Change group"]</button></form><form method="post" action="@($"/actions/users/{item.Id}/suspend")" data-confirm-submit="@(item.Suspended?T["Restore access for this user."]:T["Block sign-in and posting for this user."])" data-confirm-title="@(item.Suspended?T["Unsuspend user?"]:T["Suspend user?"])" data-confirm-label="@(item.Suspended?T["Unsuspend"]:T["Suspend"])" data-confirm-tone="danger"><AntiforgeryToken/><input type="hidden" name="suspended" value="@((!item.Suspended).ToString().ToLowerInvariant())"/><button class="btn-danger" type="submit">@(item.Suspended?T["Unsuspend"]:T["Suspend"])</button></form></div>}</article>}</section></div>
@code { private static readonly string[] RoleChoices=[ForumRoles.Member,ForumRoles.Moderator,ForumRoles.Administrator]; private readonly List<UserRow> items=[]; protected override async Task OnInitializedAsync(){foreach(var user in await Users.Users.OrderBy(u=>u.UserName).ToListAsync()){var profile=await Profiles.ByIdAsync(user.Id,CancellationToken.None);if(profile is null)continue;items.Add(new(user.Id,profile.Login,profile.DisplayName,user.Email??string.Empty,await Users.GetRolesAsync(user),user.LockoutEnd>DateTimeOffset.UtcNow));}} private sealed record UserRow(Guid Id,string Login,string DisplayName,string Email,IList<string> Roles,bool Suspended); }
